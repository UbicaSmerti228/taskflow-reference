# Скопируй в .env и поменяй значения: cp .env.example .env
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskflow

# Ключ подписи токенов, не меньше 32 байт. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me

API_PORT=8080
LOG_LEVEL=info

# Только для деплоя (deploy/compose.prod.yaml):
DOMAIN=localhost
TAG=latest
